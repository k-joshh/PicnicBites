@page "/recipes/honey-fried-chicken"

<PageTitle>Honey Fried Chicken</PageTitle>

<div class="recipe-detail-page">
    <section class="recipe-hero">
        <div class="recipe-copy">
            <h1>Honey Fried Chicken</h1>

            <p>
                A sweet, savory picnic centerpiece featuring crispy golden-brown 
                fried chicken coated in a warm honey-butter glaze.
            </p>

            <div class="meta-row">
                <span class="meta-pill">
                    <span class="meta-icon">◔</span>
                    <span>Prep: 20 min</span>
                </span>
                <span class="meta-pill">
                    <span class="meta-icon">◔</span>
                    <span>Cook: 25 min</span>
                </span>
                <span class="meta-pill">
                    <span class="meta-icon">◔</span>
                    <span>Serves: 4-6</span>
                </span>
            </div>
        </div>

        <div class="recipe-hero-image">
            <img src="images/honey-fried-chicken.jpg" alt="Honey fried chicken" />
        </div>
    </section>

    <div class="scallop-divider" aria-hidden="true"></div>

    <section class="recipe-grid">
        <article class="info-card ingredients-card">
            <h2>
                <span class="list-mark"></span>
                Ingredients List
            </h2>

            <div class="ingredient-group">
                <h3>For the chicken</h3>
                <ul>
                    <li>1 kg chicken (thighs and drumsticks)</li>
                    <li>1 cup cold buttermilk</li>
                    <li>1.5 cups all-purpose flour</li>
                    <li>1 tbsp garlic powder</li>
                    <li>1 tsp smoked paprika</li>
                    <li>Salt and black pepper (to taste)</li>
                    <li>Vegetable oil (for deep-frying)</li>
                </ul>
            </div>

            <div class="ingredient-group">
                <h3>For the honey glaze</h3>
                <ul>
                    <li>1/2 cup organic wildflower honey</li>
                    <li>2 tbsp unsalted butter</li>
                    <li>A pinch of cayenne pepper (to taste)</li>
                </ul>
            </div>
        </article>

        <article class="info-card">
            <h2>
                <span class="list-mark"></span>
                Step-by-Step Guide
            </h2>

            <ol>
                <li>Place chicken pieces in a shallow dish, pour buttermilk over, and cover. Marinate in the refrigerator for 1 to 2 hours to ensure maximum tenderness.</li>
                <li>In a wide bowl, whisk together the flour, garlic powder, smoked paprika, salt, and pepper until evenly combined.</li>
                <li>Remove each chicken piece from buttermilk, let excess drip off, and dredge thoroughly in the flour mixture to coat evenly.</li>
                <li>Heat oil to 175°C (350°F) in a deep skillet. Fry chicken in small batches for 20–25 minutes, turning occasionally until deep golden-brown and cooked through.</li>
                <li>Whisk together the honey and butter in a small saucepan over low heat. Whisk in cayenne pepper until smooth and fully emulsified.</li>
                <li>Drizzle the warm glaze over hot chicken. Allow the chicken to cool to room temperature before placing it into your picnic basket container.</li>
            </ol>
        </article>
    </section>
</div>
