@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">
    <section class="hero">
        <div class="hero-copy">
            <h1>Sunshine on a plate</h1>

            <p>
                Easy, mess-free, and delightfully appetizing mini-recipes crafted
                specifically for your picnic basket. Roll out the blanket, open a jar of
                homemade joy, and let the summer afternoon linger.
            </p>

            <a class="primary-btn" href="recipes">Explore Picnic Recipes</a>
        </div>

        <div class="hero-visual">
            <img src="images/hero-photo.png" alt="Picnic spread on a gingham blanket" />
        </div>
    </section>

    <div class="scallop-divider" aria-hidden="true"></div>

    <section class="recipes-section">
        <div class="section-heading">
            <h2>Today's Picnic Spread</h2>
            <a class="secondary-btn" href="recipes">View All Recipes</a>
        </div>

        <p class="section-subtitle">
            Perfectly portioned picnic bites that hold up beautifully in your hamper.
            Simple to prepare, incredibly delicious to share.
        </p>

        <div class="recipe-grid">
            <article class="recipe-card">
                <img src="images/honey-fried-chicken.jpg" alt="Honey fried chicken" />
                <div class="card-body">
                    <div class="meta">Prep: 20 mins</div>
                    <h3>Honey Fried Chicken</h3>
                    <p>
                        A sweet, savory picnic centerpiece featuring crispy golden-brown
                        chicken bites in a warm honey glaze.
                    </p>
                    <a class="card-button" href="recipes">
                        Get Recipe <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <article class="recipe-card">
                <img src="images/quiche-valerie.jpg" alt="Quiche Valerie" />
                <div class="card-body">
                    <div class="meta">Prep: 25 mins</div>
                    <h3>Quiche Valerie</h3>
                    <p>
                        An elegant French-style baked custard tart loaded with roasted
                        garlic, tender vegetables, and a flaky buttery crust.
                    </p>
                    <a class="card-button" href="recipes">
                        Get Recipe <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>

            <article class="recipe-card">
                <img src="images/turkey-picnic-sandwich.jpg" alt="Turkey picnic sandwich" />
                <div class="card-body">
                    <div class="meta">Prep: 20 mins</div>
                    <h3>Turkey Picnic Sandwich</h3>
                    <p>
                        A sturdy, artisan-style pressed sub layered with lean roasted turkey,
                        creamy avocado, crisp greens, and tangy tomato relish.
                    </p>
                    <a class="card-button" href="recipes">
                        Get Recipe <span aria-hidden="true">→</span>
                    </a>
                </div>
            </article>
        </div>
    </section>
</div>
