@page "/recipes"

<PageTitle>Recipes</PageTitle>

<div class="recipes-page">
    <header class="page-header">
        <h1>Recipes</h1>
        <p>
            Select your favorite dish from the picnic menu below to view its full recipe,
            prep time, and packing instructions.
        </p>
    </header>

    <div class="recipe-list">
        <article class="recipe-card">
            <div class="recipe-image">
                <img src="images/honey-fried-chicken.jpg" alt="Honey fried chicken" />
            </div>

            <div class="recipe-content">
                <div class="prep-time">
                    <span class="clock-icon">◔</span>
                    <span>Prep: 20 mins</span>
                </div>

                <h2>Honey Fried Chicken</h2>
                <p>
                    A sweet, savory picnic centerpiece featuring crispy golden-brown 
                    fried chicken coated in a warm honey-butter glaze.
                </p>

                <a href="recipes/honey-fried-chicken" class="recipe-button">
                    <span>Get Recipe</span>
                    <span class="arrow">→</span>
                </a>
            </div>
        </article>

        <article class="recipe-card reverse">
            <div class="recipe-content">
                <div class="prep-time">
                    <span class="clock-icon">◔</span>
                    <span>Prep: 25 mins</span>
                </div>

                <h2>Quiche Valerie</h2>
                <p>
                    An elegant French-style baked custard tart loaded with melted Gruyère, 
                    tender sautéed leeks, and smoky bacon inside a buttery, flaky crust.
                </p>

                <a href="recipes/quiche-valerie" class="recipe-button">
                    <span>Get Recipe</span>
                    <span class="arrow">→</span>
                </a>
            </div>

            <div class="recipe-image">
                <img src="images/quiche-valerie.jpg" alt="Quiche Valerie" />
            </div>
        </article>

        <article class="recipe-card">
            <div class="recipe-image">
                <img src="images/turkey-picnic-sandwich.jpg" alt="Turkey picnic sandwich" />
            </div>

            <div class="recipe-content">
                <div class="prep-time">
                    <span class="clock-icon">◔</span>
                    <span>Prep: 20 mins</span>
                </div>

                <h2>Turkey Picnic Sandwich</h2>
                <p>
                    A sturdy, artisan-style pressed sub layered with lean roasted turkey, 
                    creamy provolone, mashed lemon avocado, and crisp greens.
                </p>

                <a href="recipes/turkey-picnic-sandwich" class="recipe-button">
                    <span>Get Recipe</span>
                    <span class="arrow">→</span>
                </a>
            </div>
        </article>
    </div>
</div>
